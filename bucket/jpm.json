{
    "version": "1.0.0",
    "description": "Fast, small, secure-by-default package manager for JavaScript",
    "homepage": "https://getjpm.sh",
    "license": "MIT",
    "notes": "jpx is jpm run under that name: a copy of jpm.exe beside it.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/jtwebman/jpm/releases/download/v1.0.0/jpm-windows-x64.exe#/jpm.exe",
            "hash": "3dd7494b62473bfb3c6bcda36a1664955ce0f628f8f177b2a2ea54c330f68e70"
        },
        "arm64": {
            "url": "https://github.com/jtwebman/jpm/releases/download/v1.0.0/jpm-windows-arm64.exe#/jpm.exe",
            "hash": "9bd580d0490bcad958532b71895216c84d53488f85447f588288f4f4cfb79a2a"
        }
    },
    "installer": {
        "script": "Copy-Item \"$dir\\jpm.exe\" \"$dir\\jpx.exe\" -Force"
    },
    "bin": [
        "jpm.exe",
        "jpx.exe"
    ],
    "checkver": {
        "github": "https://github.com/jtwebman/jpm"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/jtwebman/jpm/releases/download/v$version/jpm-windows-x64.exe#/jpm.exe",
                "hash": {
                    "url": "https://github.com/jtwebman/jpm/releases/download/v$version/SHA256SUMS",
                    "regex": "$sha256\\s+jpm-windows-x64\\.exe"
                }
            },
            "arm64": {
                "url": "https://github.com/jtwebman/jpm/releases/download/v$version/jpm-windows-arm64.exe#/jpm.exe",
                "hash": {
                    "url": "https://github.com/jtwebman/jpm/releases/download/v$version/SHA256SUMS",
                    "regex": "$sha256\\s+jpm-windows-arm64\\.exe"
                }
            }
        }
    }
}
